<?xml version="1.0" encoding="UTF-8"?>
<!-- Giga Sketch actions. Defined here (not in Krita's own .action files) so
     they show up in Settings > Configure Shortcuts and keep custom shortcuts. -->
<ActionCollection version="2" name="Giga Sketch">
  <Actions category="File">
    <text>File</text>
    <Action name="giga_save_dated_jpg">
      <icon>document-export</icon>
      <text>Save Dated JPG</text>
      <whatsThis>Save a flattened JPG copy named after today's date (e.g. 2026-11-12.jpg, then _v2, _v3...) next to the document.</whatsThis>
      <toolTip>Save a JPG copy named after today's date next to the document</toolTip>
      <iconText>Save Dated JPG</iconText>
      <activationFlags>1</activationFlags>
      <activationConditions>0</activationConditions>
      <shortcut></shortcut>
      <isCheckable>false</isCheckable>
      <statusTip></statusTip>
    </Action>
  </Actions>
  <Actions category="Edit">
    <text>Edit</text>
    <Action name="giga_transform_last_stroke">
      <icon>transform_icons_main</icon>
      <text>Transform Last Stroke</text>
      <whatsThis>Open the Transform tool on just the stroke you painted last, so you can warp or liquify it without touching anything else on the layer. Esc puts the stroke back as drawn.</whatsThis>
      <toolTip>Warp or liquify only the stroke you painted last</toolTip>
      <iconText>Transform Last Stroke</iconText>
      <activationFlags>1</activationFlags>
      <activationConditions>0</activationConditions>
      <shortcut>Ctrl+Shift+Alt+T</shortcut>
      <isCheckable>false</isCheckable>
      <statusTip></statusTip>
    </Action>
    <Action name="giga_add_note">
      <icon>draw-text</icon>
      <text>Add Note</text>
      <whatsThis>Add a sticky note under the pointer (or in the middle of the view). Notes sit on top of the canvas like reference images: they are never painted into the image or exported, and they are saved in the .kra.</whatsThis>
      <toolTip>Add a sticky note</toolTip>
      <iconText>Add Note</iconText>
      <activationFlags>1</activationFlags>
      <activationConditions>0</activationConditions>
      <shortcut></shortcut>
      <isCheckable>false</isCheckable>
      <statusTip></statusTip>
    </Action>
  </Actions>
  <Actions category="View">
    <text>View</text>
    <Action name="giga_show_annotations">
      <icon>draw-text</icon>
      <text>Show Annotations</text>
      <whatsThis>Show or hide every sticky note. Hidden notes are kept and come back when you turn this on again.</whatsThis>
      <toolTip>Show or hide the sticky notes</toolTip>
      <iconText>Show Annotations</iconText>
      <activationFlags>0</activationFlags>
      <activationConditions>0</activationConditions>
      <shortcut></shortcut>
      <isCheckable>true</isCheckable>
      <statusTip></statusTip>
    </Action>
  </Actions>
  <Actions category="Layer">
    <text>Layer</text>
    <Action name="giga_refresh_blender_layers">
      <icon>view-refresh</icon>
      <text>Refresh Blender Layers</text>
      <whatsThis>Ask Blender (with the "Send to GigaSketch" add-on) for a new picture of its view for this document's Blender layers.</whatsThis>
      <toolTip>Ask Blender for a new picture of its view</toolTip>
      <iconText>Refresh Blender Layers</iconText>
      <activationFlags>1</activationFlags>
      <activationConditions>0</activationConditions>
      <shortcut></shortcut>
      <isCheckable>false</isCheckable>
      <statusTip></statusTip>
    </Action>
  </Actions>
</ActionCollection>
